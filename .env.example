# ================================
# Core app
# ================================

# Node environment
NODE_ENV=development

# ================================
# AWS / Amplify
# ================================

# AWS region used by Amplify + DynamoDB
AWS_REGION=ap-southeast-2

# DynamoDB table names (must match deployed tables)
FIAPP_MAIN_TABLE=FIAPP_MAIN
FIAPP_RETURNS_TABLE=FIAPP_RETURNS

# ================================
# Auth (Amplify / Cognito)
# ================================
# Leave empty in dev if auth is not wired yet

COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_IDENTITY_POOL_ID=

# ================================
# Subscription (DEV ONLY)
# ================================
# Used by /api/dev/subscription route

# Enable dev override logic
FIAPP_SUBSCRIPTION_DEV_MODE=true

# Show dev subscription toggle in header (local only; never set in prod)
# Set to "true" in .env.local to toggle Free/Paid for testing
NEXT_PUBLIC_FIAPP_DEV_SUBSCRIPTION=

# Force subscription status in dev
# Allowed values: FREE | PAID
FIAPP_FORCE_SUBSCRIPTION_STATUS=FREE

# ================================
# Analytics (GA4)
# ================================
# Set to your GA4 Measurement ID (G-XXXXXXX) to enable client-side analytics.
# Empty/missing = GA4 silently off (cookie banner won't appear either).
# Loaded only after cookie consent — see docs/operations/analytics-privacy-boundaries.md.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
